# コピーして .env.local を作り、値を入れてください（.env.local はGitに入りません）
# フィールド自動作成には schema.bases:read + schema.bases:write も必要（records:write のみだとフォーム保存のみ可）
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 任意。設定時は Airtable 保存成功後に Slack Incoming Webhook へ通知
SLACK_WEBHOOK_URL=
# Google Tag Manager コンテナ ID（GA4 等は GTM 側で設定）
NEXT_PUBLIC_GTM_ID=GTM-T654738W
# フォーム送信を許可するオリジン（カンマ区切り）。本番は必須。例: https://example.com
ALLOWED_ORIGINS=
